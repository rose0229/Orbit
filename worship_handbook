<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink:#141413; --charcoal:#313334; --sand:#dbcaad; --sand-soft:#ece1c9;
    --paper:#f6f2ea; --white:#ffffff; --mid:#6f6a61;
    --line:rgba(20,20,19,0.12); --line-strong:rgba(20,20,19,0.28);
  }
  html { font-size:16px; scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
  body { background:var(--paper); color:var(--ink); font-family:'Montserrat',sans-serif; font-weight:400; line-height:1.72; letter-spacing:0.005em; }
  .wrap { max-width:860px; margin:0 auto; padding:0 40px; }
  .eyebrow { font-family:'JetBrains Mono',monospace; font-size:0.66rem; font-weight:500; letter-spacing:0.32em; text-transform:uppercase; color:var(--mid); }
  .mono { font-family:'JetBrains Mono',monospace; }
  p { margin-bottom:1.05rem; } p:last-child { margin-bottom:0; }
  strong { font-weight:700; } em { font-style:italic; }

  /* COVER */
  .cover { background:var(--ink); color:var(--paper); position:relative; overflow:hidden; padding:92px 0 74px; }
  .cover .wrap { position:relative; z-index:2; }
  .cover .eyebrow { color:var(--sand); }
  .cover-ambient { position:absolute; top:50%; right:-180px; transform:translateY(-50%); width:620px; height:620px; z-index:1; opacity:0.9; pointer-events:none; }
  .cover-ambient circle { fill:none; stroke:rgba(219,202,173,0.16); }
  .cover-ambient .ring-live { stroke:rgba(219,202,173,0.4); }
  .cover-ambient .core { fill:var(--sand); stroke:none; }
  .cover h1 { font-weight:200; font-size:clamp(2.9rem,8vw,5.3rem); line-height:0.98; letter-spacing:-0.02em; margin:26px 0 0; }
  .cover h1 strong { font-weight:700; }
  .cover .sub { font-size:1.06rem; font-weight:300; color:rgba(246,242,234,0.82); max-width:36ch; margin-top:26px; line-height:1.55; }
  .cover-meta { margin-top:54px; padding-top:24px; border-top:1px solid rgba(219,202,173,0.28); display:flex; flex-wrap:wrap; gap:38px; }
  .cover-meta .k { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.24em; text-transform:uppercase; color:var(--sand); }
  .cover-meta .v { font-size:0.9rem; color:var(--paper); }

  /* CONTENTS */
  .contents { background:var(--charcoal); color:var(--paper); padding:44px 0; }
  .contents .eyebrow { color:var(--sand); margin-bottom:20px; display:block; }
  .toc-tier { margin-bottom:18px; }
  .toc-tier:last-child { margin-bottom:0; }
  .toc-tier > a { display:flex; align-items:baseline; gap:12px; color:var(--paper); text-decoration:none; padding:6px 0; border-bottom:1px solid rgba(246,242,234,0.14); }
  .toc-tier > a:hover { color:var(--sand); }
  .toc-tier .rn { font-family:'JetBrains Mono',monospace; font-size:0.68rem; color:var(--sand); width:2.4rem; }
  .toc-tier .tt { font-size:1rem; font-weight:600; letter-spacing:0.02em; }
  .toc-sub { display:flex; flex-wrap:wrap; gap:6px 18px; padding:10px 0 0 3.4rem; }
  .toc-sub a { color:rgba(246,242,234,0.7); text-decoration:none; font-size:0.82rem; }
  .toc-sub a:hover { color:var(--sand); }

  /* TIER BANDS */
  .tier { background:var(--ink); color:var(--paper); padding:58px 0; }
  .tier .wrap { display:flex; align-items:center; gap:32px; }
  .tier .pyr { flex-shrink:0; }
  .tier .pyr polygon { fill:none; stroke:rgba(219,202,173,0.5); stroke-width:1.2; }
  .tier .pyr .on { fill:var(--sand); stroke:var(--sand); }
  .tier .tlabel { font-family:'JetBrains Mono',monospace; font-size:0.68rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--sand); }
  .tier h2 { font-weight:200; font-size:clamp(2rem,6vw,3.2rem); line-height:1.02; letter-spacing:-0.02em; margin:10px 0 12px; }
  .tier h2 strong { font-weight:700; }
  .tier .tsum { font-size:1rem; font-weight:300; color:rgba(246,242,234,0.8); max-width:52ch; }

  /* SECTIONS */
  section.block { padding:56px 0; border-bottom:1px solid var(--line); }
  .lead { font-size:1.08rem; font-weight:300; line-height:1.6; margin-bottom:1.4rem; }
  .lead strong { font-weight:600; }
  h3 { font-size:0.82rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; margin:2.2rem 0 0.9rem; }
  h3:first-child { margin-top:0; }
  h4.sub { font-family:'JetBrains Mono',monospace; font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--white); background:var(--charcoal); display:inline-block; padding:5px 12px; margin:2rem 0 1rem; }
  .domain-title { display:flex; align-items:baseline; gap:14px; margin:0 0 4px; }
  .domain-title .dn { font-family:'JetBrains Mono',monospace; font-size:1.1rem; color:var(--ink); }
  .domain-title h3 { margin:0; font-size:1.15rem; letter-spacing:-0.01em; text-transform:none; }
  .serves { font-family:'JetBrains Mono',monospace; font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--mid); border-left:2px solid var(--sand); padding:2px 0 2px 10px; margin:0 0 18px; }
  .serves b { color:var(--charcoal); font-weight:700; }
  .pc-note { font-family:'JetBrains Mono',monospace; font-size:0.72rem; line-height:1.5; color:var(--mid); background:var(--sand-soft); border:1px solid var(--line); padding:10px 14px; margin:16px 0; }
  .pc-note b { color:var(--ink); }

  .conviction { background:var(--ink); color:var(--paper); padding:32px 36px; margin:28px 0; }
  .conviction p { font-weight:300; font-size:1.14rem; line-height:1.5; }
  .conviction strong { color:var(--sand); font-weight:700; }
  .conviction .eyebrow { color:var(--sand); margin-bottom:12px; display:block; }

  .quote-mission { border-left:3px solid var(--sand); padding:6px 0 6px 22px; margin:22px 0; font-weight:300; font-size:1.16rem; line-height:1.45; }
  .quote-mission span { font-family:'JetBrains Mono',monospace; display:block; font-size:0.62rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--mid); margin-top:10px; font-weight:400; }

  .cards { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin:22px 0; }
  .card { background:var(--white); border:1px solid var(--line); border-top:3px solid var(--sand); padding:20px 22px; }
  .card .lbl { font-family:'JetBrains Mono',monospace; font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--mid); margin-bottom:8px; }
  .card h4 { font-size:0.98rem; font-weight:700; margin-bottom:6px; }
  .card p { font-size:0.85rem; line-height:1.5; color:var(--charcoal); margin:0; }
  .card .from { display:block; margin-top:9px; font-family:'JetBrains Mono',monospace; font-size:0.58rem; letter-spacing:0.04em; text-transform:uppercase; color:var(--mid); }

  /* ORG CHART */
  .org { margin:26px 0 10px; }
  .org-tier { display:flex; justify-content:center; }
  .node { background:var(--white); border:1px solid var(--line-strong); border-top:3px solid var(--sand); padding:11px 18px; text-align:center; min-width:170px; }
  .node .role { font-weight:700; font-size:0.9rem; line-height:1.2; }
  .node span { display:block; font-family:'JetBrains Mono',monospace; font-size:0.56rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--mid); margin-top:5px; }
  .node.lead { background:transparent; border:1px dashed var(--line-strong); }
  .node.head { background:var(--ink); color:var(--paper); border-top-color:var(--sand); min-width:230px; }
  .node.head span { color:var(--sand); }
  .rail { width:1px; height:20px; background:var(--line-strong); margin:0 auto; }
  .org-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; position:relative; margin-top:0; }
  .org-row::before { content:''; position:absolute; top:-20px; left:12.5%; right:12.5%; height:1px; background:var(--line-strong); }
  .branch { display:flex; flex-direction:column; align-items:center; }
  .branch .rail { height:20px; }
  .branch .node { min-width:0; width:100%; }
  .branch ul { list-style:none; margin:8px 0 0; padding:0; text-align:center; }
  .branch ul li { font-family:'JetBrains Mono',monospace; font-size:0.68rem; color:var(--charcoal); padding:2px 0; line-height:1.3; }
  .org-cap { font-size:0.82rem; color:var(--mid); text-align:center; margin-top:16px; font-style:italic; }

  .people { margin:18px 0; border-top:1px solid var(--line-strong); }
  .person { display:grid; grid-template-columns:200px 1fr; gap:24px; padding:14px 0; border-bottom:1px solid var(--line); }
  .person .who { font-weight:700; font-size:0.93rem; }
  .person .who span { display:block; font-family:'JetBrains Mono',monospace; font-weight:400; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--mid); margin-top:3px; }
  .person .what { font-size:0.88rem; color:var(--charcoal); line-height:1.5; }

  .roles { margin:14px 0 8px; }
  .role { background:var(--white); border:1px solid var(--line); border-left:3px solid var(--sand); padding:16px 20px; margin-bottom:12px; }
  .role .rtop { display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; }
  .role .rname { font-weight:700; font-size:1rem; }
  .role .rrep { font-family:'JetBrains Mono',monospace; font-size:0.57rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--mid); white-space:nowrap; }
  .role .rpurpose { font-size:0.9rem; color:var(--charcoal); margin:7px 0 11px; line-height:1.5; }
  .role .rlabel { font-family:'JetBrains Mono',monospace; font-size:0.57rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--mid); margin-bottom:5px; }
  .role ul { list-style:none; margin:0; padding:0; }
  .role ul li { position:relative; padding:3px 0 3px 16px; font-size:0.85rem; line-height:1.45; color:var(--charcoal); }
  .role ul li::before { content:''; position:absolute; left:2px; top:11px; width:5px; height:5px; background:var(--sand); border-radius:50%; }
  .role .rbar { font-size:0.83rem; color:var(--ink); margin-top:9px; padding-top:9px; border-top:1px solid var(--line); }
  .role .rbar b { font-family:'JetBrains Mono',monospace; font-size:0.57rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--mid); font-weight:500; margin-right:6px; }
  .role.future { border-left-style:dashed; }
  .role.nested { margin-left:22px; }
  .tag-future { font-family:'JetBrains Mono',monospace; font-size:0.54rem; letter-spacing:0.12em; text-transform:uppercase; background:var(--sand-soft); border:1px solid var(--line); padding:2px 7px; color:var(--charcoal); }
  .roles-cap { font-size:0.86rem; color:var(--mid); margin:0 0 4px; }
  @media (max-width:680px) { .role.nested { margin-left:10px; } }

  .flow { margin:20px 0; counter-reset:step; }
  .step { display:flex; gap:18px; padding:12px 0; border-bottom:1px solid var(--line); }
  .step:last-child { border-bottom:none; }
  .step::before { counter-increment:step; content:counter(step,decimal-leading-zero); font-family:'JetBrains Mono',monospace; font-size:0.78rem; font-weight:500; color:var(--sand); background:var(--ink); width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .step .body { padding-top:3px; font-size:0.9rem; line-height:1.5; } .step .body b { font-weight:700; }

  .timeline { margin:20px 0; }
  .tl { display:grid; grid-template-columns:96px 1fr; gap:18px; padding:10px 0; border-bottom:1px solid var(--line); }
  .tl:last-child { border-bottom:none; }
  .tl .t { font-family:'JetBrains Mono',monospace; font-size:0.8rem; font-weight:500; color:var(--ink); }
  .tl .e { font-size:0.88rem; line-height:1.45; } .tl .e b { font-weight:700; }
  .tl.svc .t { color:var(--ink); } .tl.svc { background:var(--sand-soft); }

  table { width:100%; border-collapse:collapse; margin:20px 0; font-size:0.86rem; }
  th { text-align:left; font-family:'JetBrains Mono',monospace; font-size:0.62rem; font-weight:500; letter-spacing:0.12em; text-transform:uppercase; color:var(--mid); padding:8px 12px; border-bottom:2px solid var(--ink); }
  td { padding:11px 12px; border-bottom:1px solid var(--line); vertical-align:top; line-height:1.45; }
  td.mono, th.mono { font-family:'JetBrains Mono',monospace; }
  tr:last-child td { border-bottom:none; }

  .checklist { list-style:none; margin:16px 0; }
  .checklist li { display:flex; gap:12px; padding:8px 0; font-size:0.89rem; line-height:1.45; border-bottom:1px solid var(--line); }
  .checklist li:last-child { border-bottom:none; }
  .checklist .box { width:15px; height:15px; border:1.5px solid var(--ink); flex-shrink:0; margin-top:4px; }

  .chips { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0 6px; }
  .chip { font-family:'JetBrains Mono',monospace; font-size:0.74rem; background:var(--sand-soft); border:1px solid var(--line); padding:5px 11px; }
  .chip span { color:var(--mid); }
  .flowcall { background:var(--white); border:1px solid var(--line); border-left:3px solid var(--charcoal); padding:14px 18px; margin:12px 0; }
  .flowcall .call { font-family:'JetBrains Mono',monospace; font-size:0.82rem; font-weight:500; color:var(--ink); }
  .flowcall .mean { font-size:0.82rem; color:var(--mid); margin-top:3px; }

  .strip { background:var(--sand); color:var(--ink); padding:18px 24px; margin:26px 0; display:flex; gap:16px; align-items:flex-start; }
  .strip .mk { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:0.7rem; letter-spacing:0.1em; padding-top:3px; white-space:nowrap; }
  .strip p { font-size:0.9rem; font-weight:500; line-height:1.5; margin:0; }
  .strip.dark { background:var(--charcoal); color:var(--paper); } .strip.dark .mk { color:var(--sand); }

  ul.plain { list-style:none; margin:14px 0; }
  ul.plain li { position:relative; padding:6px 0 6px 22px; font-size:0.9rem; line-height:1.5; border-bottom:1px solid var(--line); }
  ul.plain li:last-child { border-bottom:none; }
  ul.plain li::before { content:''; position:absolute; left:4px; top:15px; width:6px; height:6px; background:var(--sand); border:1px solid var(--line-strong); border-radius:50%; }

  .close { background:var(--ink); color:var(--paper); padding:70px 0; }
  .close .eyebrow { color:var(--sand); }
  .close h2 { font-weight:200; font-size:clamp(1.8rem,5vw,2.8rem); line-height:1.1; margin:20px 0; letter-spacing:-0.015em; }
  .close h2 strong { font-weight:700; }
  .close p { color:rgba(246,242,234,0.82); font-weight:300; max-width:60ch; }
  .close .sources { margin-top:38px; padding-top:26px; border-top:1px solid rgba(219,202,173,0.28); display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .close .sources .k { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--sand); margin-bottom:6px; }
  .close .sources .v { font-size:0.85rem; color:var(--paper); line-height:1.45; }

  .printbtn { position:fixed; bottom:22px; right:22px; z-index:50; display:inline-flex; align-items:center; gap:9px; background:var(--ink); color:var(--paper); border:1px solid var(--sand); font-family:'JetBrains Mono',monospace; font-size:0.68rem; font-weight:500; letter-spacing:0.14em; text-transform:uppercase; padding:12px 17px; border-radius:999px; cursor:pointer; box-shadow:0 6px 22px rgba(20,20,19,0.3); transition:background .15s ease, color .15s ease; }
  .printbtn:hover { background:var(--sand); color:var(--ink); }
  .printbtn svg { width:15px; height:15px; }
  .printbtn svg * { stroke:currentColor; fill:none; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  @media print { .printbtn { display:none !important; } }
  @media (max-width:680px) { .printbtn { bottom:16px; right:16px; padding:11px 14px; font-size:0.62rem; } }

  .footer { background:var(--charcoal); color:rgba(246,242,234,0.6); padding:22px 0; font-family:'JetBrains Mono',monospace; font-size:0.64rem; letter-spacing:0.1em; }
  .footer .wrap { display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; }

  @media (max-width:680px) {
    .wrap { padding:0 22px; }
    .cards { grid-template-columns:1fr; }
    .person { grid-template-columns:1fr; gap:4px; }
    .close .sources { grid-template-columns:1fr; }
    .cover-ambient { width:420px; height:420px; right:-160px; opacity:0.5; }
    .tier .wrap { flex-direction:column; align-items:flex-start; gap:18px; }
    .org-row { grid-template-columns:repeat(2,1fr); gap:10px 8px; }
    .org-row::before { display:none; }
    .tl { grid-template-columns:80px 1fr; gap:12px; }
  }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
  @media print {
    :root { --paper:#ffffff; }
    body { background:#fff; }
    * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    .contents, .printbtn { display:none !important; }
    .wrap { max-width:100%; padding:0 0.5in; }
    .cover { padding:48px 0; min-height:9.3in; display:flex; align-items:center; break-after:page; }
    .close { padding:46px 0; break-before:page; }
    section.block { padding:30px 0; }
    .tier { padding:34px 0; break-inside:avoid; }
    .card, .role, .tl, .person, .step, .flowcall, .strip, .conviction, .quote-mission, .pc-note, .org, .chips, table tr { break-inside:avoid; }
    h3, h4.sub, .domain-title, .serves, .roles-cap, .lead { break-after:avoid; }
    p, li { orphans:3; widows:3; }
    a { color:inherit; text-decoration:none; }
  }
</style>
</head>
